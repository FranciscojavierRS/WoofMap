<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/woofmap_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crear_lugar_overline"
            android:textAppearance="@style/TextAppearance.WoofMap.Overline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="serif"
            android:text="@string/crear_lugar_titulo"
            android:textAppearance="@style/TextAppearance.WoofMap.Titulo"
            android:textColor="@color/woofmap_text_primary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNombre"
            style="@style/Widget.WoofMap.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/crear_lugar_nombre">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:inputType="textCapSentences"
                android:maxLength="150"
                android:textColor="@color/woofmap_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutCategoria"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/crear_lugar_categoria">

            <AutoCompleteTextView
                android:id="@+id/spinnerCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/woofmap_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDescripcion"
            style="@style/Widget.WoofMap.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/crear_lugar_descripcion">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:lines="3"
                android:maxLines="6"
                android:textColor="@color/woofmap_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/crear_lugar_ubicacion"
            android:textAppearance="@style/TextAppearance.WoofMap.Overline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:text="@string/crear_lugar_instruccion_mapa"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/woofmap_text_secondary" />

        <org.maplibre.android.maps.MapView
            android:id="@+id/miniMapa"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_card" />

        <TextView
            android:id="@+id/textoCoords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/crear_lugar_sin_punto"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/woofmap_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonCrear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/crear_lugar_boton" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
