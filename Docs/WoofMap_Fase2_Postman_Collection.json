{
  "info": {
    "name": "WoofMap - Fase 2 (Autenticación JWT y Seguridad)",
    "_postman_id": "woofmap-fase2-collection",
    "description": "Coleccion de pruebas para la Fase 2 de WoofMap: Registro, Login con JWT y proteccion de endpoints por creador",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "tokenUsuario1",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenUsuario2",
      "value": "",
      "type": "string"
    },
    {
      "key": "lugarId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "1.1 Registro Usuario 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('tokenUsuario1', jsonData.token);",
                  "}",
                  "pm.test('Status code es 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Uno\",\n  \"email\": \"usuario1@woofmap.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Registro con Email Duplicado (409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Duplicado\",\n  \"email\": \"usuario1@woofmap.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.3 Login Usuario 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('tokenUsuario1', jsonData.token);",
                  "}",
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario1@woofmap.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.4 Login Credenciales Incorrectas (401 Unauthorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario1@woofmap.com\",\n  \"password\": \"passwordErronea\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.5 Registro Usuario 2 (Para pruebas de permisos)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('tokenUsuario2', jsonData.token);",
                  "}",
                  "pm.test('Status code es 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Dos\",\n  \"email\": \"usuario2@woofmap.com\",\n  \"password\": \"password456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Lugares y Seguridad",
      "item": [
        {
          "name": "2.1 Crear Lugar con Token de Usuario 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('lugarId', jsonData.id);",
                  "}",
                  "pm.test('Status code es 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenUsuario1}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Parque Canino del Retiro\",\n  \"descripcion\": \"Amplia zona ajardinada y cercada con fuentes de agua para perros.\",\n  \"categoria\": \"PARQUE\",\n  \"lat\": 40.4153,\n  \"lon\": -3.6844\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/lugares",
              "host": ["{{baseUrl}}"],
              "path": ["lugares"]
            }
          }
        },
        {
          "name": "2.2 Crear Lugar Sin Token (401 Unauthorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Lugar no autorizado\",\n  \"categoria\": \"PARQUE\",\n  \"lat\": 40.4153,\n  \"lon\": -3.6844\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/lugares",
              "host": ["{{baseUrl}}"],
              "path": ["lugares"]
            }
          }
        },
        {
          "name": "2.3 Crear Lugar Con Token Inválido (401 Unauthorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer token.invalido.o.corrupto"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Lugar token invalido\",\n  \"categoria\": \"PARQUE\",\n  \"lat\": 40.4153,\n  \"lon\": -3.6844\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/lugares",
              "host": ["{{baseUrl}}"],
              "path": ["lugares"]
            }
          }
        },
        {
          "name": "2.4 Listar Lugares Público (200 OK sin token)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/lugares?lat=40.4168&lon=-3.7038&radio=5000",
              "host": ["{{baseUrl}}"],
              "path": ["lugares"],
              "query": [
                {
                  "key": "lat",
                  "value": "40.4168"
                },
                {
                  "key": "lon",
                  "value": "-3.7038"
                },
                {
                  "key": "radio",
                  "value": "5000"
                }
              ]
            }
          }
        },
        {
          "name": "2.5 Editar Lugar por el Creador (Usuario 1 -> 200 OK)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenUsuario1}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Parque Canino del Retiro Renovado\",\n  \"descripcion\": \"Instalaciones renovadas por su creador.\",\n  \"categoria\": \"PARQUE\",\n  \"lat\": 40.4150,\n  \"lon\": -3.6840\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/lugares/{{lugarId}}",
              "host": ["{{baseUrl}}"],
              "path": ["lugares", "{{lugarId}}"]
            }
          }
        },
        {
          "name": "2.6 Editar Lugar por Usuario No Creador (Usuario 2 -> 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 403', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenUsuario2}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Intento de modificacion ajena\",\n  \"categoria\": \"PARQUE\",\n  \"lat\": 40.4150,\n  \"lon\": -3.6840\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/lugares/{{lugarId}}",
              "host": ["{{baseUrl}}"],
              "path": ["lugares", "{{lugarId}}"]
            }
          }
        },
        {
          "name": "2.7 Eliminar Lugar por Usuario No Creador (Usuario 2 -> 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 403', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenUsuario2}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lugares/{{lugarId}}",
              "host": ["{{baseUrl}}"],
              "path": ["lugares", "{{lugarId}}"]
            }
          }
        },
        {
          "name": "2.8 Eliminar Lugar por el Creador (Usuario 1 -> 204 No Content)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 204', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenUsuario1}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lugares/{{lugarId}}",
              "host": ["{{baseUrl}}"],
              "path": ["lugares", "{{lugarId}}"]
            }
          }
        }
      ]
    }
  ]
}
